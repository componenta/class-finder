{
    "name": "componenta/class-finder",
    "description": "Lazy class discovery with composable predicates and listener notification",
    "keywords": [
        "class-finder",
        "class-discovery",
        "php-reflection",
        "attribute-filter",
        "tokenizer",
        "autoloader",
        "psr-11"
    ],
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/componenta/filter"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/iterator"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/finder": "^7.0 || ^8.0",
        "componenta/tokenizer": "^1.0",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^2.0",
        "componenta/filter": "dev-audit/filter-tdd-fixes-20260911 as 2.0.0",
        "componenta/iterator": "dev-fix/replayable-independent-cursors-20260911 as 1.1.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\ClassFinder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\ClassFinder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\ClassFinder\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
